# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# https://typesafe.ai
TYPESAFE_API_KEY=
# https://tavily.com: the agent's web_search and fetch_url tools
TAVILY_API_KEY=
# Vercel Blob read-write token: set automatically when a Blob store is connected to the project;
# enables 20 MB attachments (without it, the browser reads files and sends them inline)
BLOB_READ_WRITE_TOKEN=
# optional, defaults to openai/gpt-6.1-sol
ATLAS_AGENT_MODEL=
